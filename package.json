{
  "name": "vrron",
  "private": true,
  "version": "0.1.0",
  "description": "VRRON — One Vision. Infinite Intelligence.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node scripts/check-config.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api:start": "npm run start -w @vrron/api",
    "mobile:start": "npm run start -w @vrron/mobile",
    "build:android:preview": "cd apps/mobile && npx eas-cli@latest build --platform android --profile preview",
    "build:android:status": "cd apps/mobile && npx eas-cli@latest build:list --platform android --limit 5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3"
  }
}
